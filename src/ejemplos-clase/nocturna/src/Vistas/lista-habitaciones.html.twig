<!--
  Vista del listado de habitaciones del hotel Nocturna.
  @author Antonio José Sánchez Bujaldón
-->
<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hotel Nocturna - Gestión de Habitaciones</title>
  <!-- Bootstrap 5.3 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-yEPZ7jP9S0QKiUQ0m3jjsO4ProIW7wvR9gXkI7JOGa2XVsw53Yke2bsdkBbjmmiX" crossorigin="anonymous">

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/Libreria/nocturna.css" rel="stylesheet" />
</head>
<body>

  <!-- Menú Superior -->
  <nav class="navbar navbar-expand-lg navbar-dark navbar-nocturna py-3">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="index.html">
        <i class="bi bi-moon-stars-fill text-danger"></i>
        NOCTURNA
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNocturna" aria-controls="menuNocturna" aria-expanded="false" aria-label="Alternar navegación">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="menuNocturna">
        <ul class="navbar-nav ms-auto gap-2">
          <li class="nav-item">
            <a class="nav-link active fw-semibold" aria-current="page" href="index.html">INICIO</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#registrar-cliente">Registrar cliente</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#consultar-huespedes">Consultar huéspedes</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Contenido Principal -->
  <main class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="h3 mb-0">Panel de Habitaciones</h1>
      <span class="badge bg-dark border border-secondary text-light px-3 py-2">
        Hotel Nocturna
      </span>
    </div>

    <div class="card card-nocturna shadow-lg">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-dark table-hover table-nocturna align-middle mb-0" id="tablaHabitaciones">
            <thead>
              <tr class="text-uppercase small text-secondary">
                <th class="ps-4 py-3">Número</th>
                <th class="py-3">Nombre</th>
                <th class="py-3">Capacidad</th>
                <th class="py-3">Estado</th>
                <th class="py-3">Precio / Noche</th>
                <th class="pe-4 py-3 text-end">Acciones</th>
              </tr>
            </thead>
            <tbody>
              
              {% for item in habitaciones %}  
              {# set disponible = item.estado.name == enumerado #}
              {# set disponible = item.estado.name == 'DISPONIBLE' #}              
              {% set disponible = item.estado == enum('Nocturna\\Modelos\\Estado').DISPONIBLE %}              

              {% set estado = disponible?"success":"danger" %}
              {% set texto = disponible?"Libre":"Ocupada" %}
              <tr data-estado="libre">
                <td class="ps-4 fw-bold">{{ item.numero }}</td>
                <td>{{ item.nombre }}</td>
                <td><i class="bi bi-people-fill me-1 text-secondary"></i>{{ item.capacidad }}</td>
                <td class="estado-celda"><span class="badge text-bg-{{ estado }}">{{ texto }}</span></td>
                <td>{{ item.precio }} €</td>
                <td class="pe-4 text-end">
                  <button class="btn btn-sm btn-reservar me-1" onclick="cambiarEstado(this, 'reservada')">Reservar</button>
                  <button class="btn btn-sm btn-outline-secondary" onclick="cambiarEstado(this, 'libre')" disabled>Liberar</button>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</body>
</html>