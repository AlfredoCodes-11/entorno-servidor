<!--
  Vista del formulario de alta de habitaciones del hotel Nocturna.
-->
<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hotel Nocturna - Nueva Habitación</title>
  <!-- Bootstrap 5.3 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-yEPZ7jP9S0QKiUQ0m3jjsO4ProIW7wvR9gXkI7JOGa2XVsw53Yke2bsdkBbjmmiX" crossorigin="anonymous">

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/Libreria/nocturna.css" rel="stylesheet" />
</head>
<body>

  <!-- Menú Superior -->
  <nav class="navbar navbar-expand-lg navbar-dark navbar-nocturna py-3">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="index.php">
        <i class="bi bi-moon-stars-fill text-danger"></i>
        NOCTURNA
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNocturna" aria-controls="menuNocturna" aria-expanded="false" aria-label="Alternar navegación">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="menuNocturna">
        <ul class="navbar-nav ms-auto gap-2">
          <li class="nav-item">
            <a class="nav-link" href="index.php">INICIO</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#registrar-cliente">Registrar cliente</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#consultar-huespedes">Consultar huéspedes</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Contenido Principal -->
  <main class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="h3 mb-0">Nueva Habitación</h1>
      <a href="index.php" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver al panel
      </a>
    </div>

    {% if error %}
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
      <i class="bi bi-exclamation-triangle-fill"></i>
      {{ error }}
    </div>
    {% endif %}

    {# Si el formulario vuelve con un error, conservamos lo que escribió el usuario #}
    {% set estadoElegido = datos.estado ?? "1" %}

    <div class="card card-nocturna shadow-lg">
      <div class="card-body p-4">
        <form action="index.php?accion=guardar" method="post">
          <div class="row g-3">

            <div class="col-md-4">
              <label for="numero" class="form-label">Número</label>
              <input type="number" class="form-control" id="numero" name="numero"
                     min="1" required value="{{ datos.numero ?? '' }}">
            </div>

            <div class="col-md-8">
              <label for="nombre" class="form-label">Nombre</label>
              <input type="text" class="form-control" id="nombre" name="nombre"
                     maxlength="100" required value="{{ datos.nombre ?? '' }}">
            </div>

            <div class="col-md-4">
              <label for="capacidad" class="form-label">Capacidad (huéspedes)</label>
              <input type="number" class="form-control" id="capacidad" name="capacidad"
                     min="1" required value="{{ datos.capacidad ?? '1' }}">
            </div>

            <div class="col-md-4">
              <label for="precio" class="form-label">Precio por noche (€)</label>
              <input type="number" class="form-control" id="precio" name="precio"
                     min="0" step="0.01" required value="{{ datos.precio ?? '' }}">
            </div>

            <div class="col-md-4">
              <label for="estado" class="form-label">Estado</label>
              <select class="form-select" id="estado" name="estado">
                <option value="1" {{ estadoElegido == "1" ? "selected" }}>Libre</option>
                <option value="0" {{ estadoElegido == "0" ? "selected" }}>Ocupada</option>
              </select>
            </div>

          </div>

          <div class="d-flex justify-content-end gap-2 mt-4">
            <a href="index.php" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-reservar">
              <i class="bi bi-check-lg me-1"></i>Guardar habitación
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
</body>
</html>
