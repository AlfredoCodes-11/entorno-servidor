{% extends "base.html.twig" %}

{% set colores = { "baja": "success", "media": "warning", "alta": "danger" } %}

{% block titulo %}Senderismo - {{ ruta ? ruta.nombre : "Ruta no encontrada" }}{% endblock %}

{% block contenido %}

  <a href="index.php" class="btn btn-outline-secondary mb-4">
    <i class="bi bi-arrow-left me-1"></i>Volver a las rutas
  </a>

  {% if ruta %}

    <div class="card shadow-sm">
      <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
          <div>
            <h1 class="h3 mb-1">{{ ruta.nombre }}</h1>
            <p class="text-secondary mb-0"><i class="bi bi-geo-alt me-1"></i>{{ ruta.localidad }}</p>
          </div>
          <span class="badge fs-6 text-bg-{{ colores[ruta.dificultad] }}">Dificultad {{ ruta.dificultad }}</span>
        </div>

        <div class="row g-3">
          <div class="col-sm-4">
            <div class="dato">
              <span class="dato-etiqueta">Distancia</span>
              <span class="dato-valor">{{ ruta.distancia|number_format(1, ",", ".") }} km</span>
            </div>
          </div>
          <div class="col-sm-4">
            <div class="dato">
              <span class="dato-etiqueta">Desnivel</span>
              <span class="dato-valor">{{ ruta.desnivel }} m</span>
            </div>
          </div>
          <div class="col-sm-4">
            <div class="dato">
              <span class="dato-etiqueta">Identificador</span>
              <span class="dato-valor">{{ ruta.idRuta }}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

  {% else %}

    <div class="alert alert-warning">La ruta que buscas no existe.</div>

  {% endif %}

{% endblock %}
