{% extends "base.html.twig" %}

{% set colores = { "baja": "success", "media": "warning", "alta": "danger" } %}

{% block titulo %}Senderismo - Rutas{% endblock %}

{% block contenido %}

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="h3 mb-0">Rutas disponibles</h1>

    <form action="index.php" method="get" class="d-flex gap-2">
      <input type="hidden" name="accion" value="ruta-filtrar">
      <select name="dificultad" class="form-select">
        <option value="">Todas las dificultades</option>
        {% for opcion in dificultades %}
          <option value="{{ opcion }}" {{ opcion == dificultad ? "selected" }}>{{ opcion|capitalize }}</option>
        {% endfor %}
      </select>
      <button type="submit" class="btn btn-senderismo">Filtrar</button>
    </form>
  </div>

  <p class="text-secondary">
    {{ rutas|length }} ruta(s)
    {% if dificultad != "" %}
      de dificultad <strong>{{ dificultad }}</strong> ·
      <a href="index.php">ver todas</a>
    {% endif %}
  </p>

  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4">Nombre</th>
            <th>Localidad</th>
            <th>Distancia</th>
            <th>Desnivel</th>
            <th>Dificultad</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {% for ruta in rutas %}
          <tr>
            <td class="ps-4 fw-semibold">{{ ruta.nombre }}</td>
            <td>{{ ruta.localidad }}</td>
            <td>{{ ruta.distancia|number_format(1, ",", ".") }} km</td>
            <td>{{ ruta.desnivel }} m</td>
            <td><span class="badge text-bg-{{ colores[ruta.dificultad] }}">{{ ruta.dificultad|capitalize }}</span></td>
            <td class="pe-4 text-end">
              <a href="index.php?accion=ruta-ver&id={{ ruta.idRuta }}" class="btn btn-sm btn-outline-secondary">Ver ruta</a>
            </td>
          </tr>
          {% else %}
          <tr>
            <td colspan="6" class="text-center text-secondary py-4">No hay rutas disponibles.</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

{% endblock %}
